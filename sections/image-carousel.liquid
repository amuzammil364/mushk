{{ 'flickity.min.css' | asset_url | stylesheet_tag }}

<div class="csm-image-carousel csm-image-carousel-{{ section.id }}">
  {% for block in section.blocks %}
    <div class="csm-image-carousel__cell">
      {% if block.settings.image != blank %}
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}">
        {% endif %}

        <img
          src="{{ block.settings.image | image_url: width: 400 }}"
          alt="Image"
          loading="lazy"
        >

        {% if block.settings.link != blank %}
          </a>
        {% endif %}
      {% endif %}
    </div>
  {% endfor %}
</div>

<script
  src="{{ 'flickity.pkgd.min.js' | asset_url }}"
  defer
></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  new Flickity('.csm-image-carousel-{{ section.id }}', {
    cellAlign: 'left',
    contain: true,
    wrapAround: true,
    pageDots: false,
    prevNextButtons: false,
    groupCells: true,
    draggable: true,
  });
});
</script>

<style>

    .csm-image-carousel-{{ section.id }} {
        --desktop-columns: {{ section.settings.desktop_columns }};
        --mobile-columns: {{ section.settings.mobile_columns }};
    }

    .csm-image-carousel {
        width: 100%;
    }

    .csm-image-carousel__cell {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .csm-image-carousel__cell img {
        max-width: 100%;
        height: auto;
        object-fit: contain;
        transition: 0.3s ease;
    }

    .csm-image-carousel__cell img:hover {
        transform: scale(1.05);
    }

    @media (min-width: 769px) {
        .csm-image-carousel__cell {
            width: calc(100% / var(--desktop-columns));
        }
    }

    @media (max-width: 768px) {
        .csm-image-carousel__cell {
            width: calc(100% / var(--mobile-columns));
        }
    }
</style>

{% schema %}

{
  "name": "CSM Image Carousel",
  "settings": [
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "mobile_columns",
      "label": "Mobile Columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "CSM Image Carousel"
    }
  ]
}

{% endschema %}