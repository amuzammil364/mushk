{{ 'flickity.min.css' | asset_url | stylesheet_tag }}

<div class="csm-image-carousel csm-image-carousel-{{ section.id }} color-{{ section.settings.color_scheme }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  {% for block in section.blocks %}
    <div class="csm-image-carousel__cell">
      {% if block.settings.image != blank %}
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}">
        {% endif %}

        <img
          src="{{ block.settings.image | image_url: width: 400 }}"
          alt="Image"
          loading="lazy"
        >

        {% if block.settings.link != blank %}
          </a>
        {% endif %}
      {% endif %}
    </div>
  {% endfor %}
</div>

{% assign show_arrows = false %}
{% assign show_dots = true %}

{% if section.settings.navigation_style == 'arrows' %}
  {% assign show_arrows = true %}
  {% assign show_dots = false %}
{% elsif section.settings.navigation_style == 'none' %}
  {% assign show_arrows = false %}
  {% assign show_dots = false %}
{% endif %}

<script
  src="{{ 'flickity.pkgd.min.js' | asset_url }}"
  defer
></script>

<script>
document.addEventListener('DOMContentLoaded', function () {

  var isMobile = window.innerWidth < 768;

  new Flickity('.csm-image-carousel-{{ section.id }}', {
    cellAlign: 'left',
    contain: true,
    wrapAround: true,
    prevNextButtons: {{ show_arrows }},
    pageDots: {{ show_dots }},
    draggable: true,
    autoPlay: 4000,

    groupCells: isMobile 
      ? {{ section.settings.mobile_columns }} 
      : {{ section.settings.desktop_columns }}
  });

});
</script>

<style>

    .csm-image-carousel-{{ section.id }} {
        --desktop-columns: {{ section.settings.desktop_columns }};
        --mobile-columns: {{ section.settings.mobile_columns }};
        width: 100%;
        max-width: var(--page-width);
        padding: 0 5rem;
        margin: 0 auto;
        box-shadow: none !important;
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .csm-image-carousel-{{ section.id }} .csm-image-carousel__cell {
        padding: 0 {{ section.settings.cell_gap }}px;
        box-sizing: border-box;
        border-radius: {{ section.settings.border_radius }}px;
    }

    .csm-image-carousel-{{ section.id }} .csm-image-carousel__cell img {
        width: 100%;
        max-width: 100%;
        height: auto;
        object-fit: cover;
        border-radius: {{ section.settings.border_radius }}px;
    }

    .csm-image-carousel-{{ section.id }} .flickity-button{
        display: block !important;
        background-color: rgba(var(--color-button),var(--alpha-button-background));
        color: rgb(var(--color-button-text));
    }

    .csm-image-carousel-{{ section.id }} .flickity-button:active{
        opacity: 1 !important;
    }

    .csm-image-carousel-{{ section.id }} .flickity-button:focus{
        box-shadow: none !important;
    }

    .csm-image-carousel-{{ section.id }} .flickity-prev-next-button .flickity-button-icon{
        left: 50%;
        top: 50%;
        width: 40%;
        height: 40%;
        transform: translate(-50%, -50%);
    }

    .csm-image-carousel-{{ section.id }} .flickity-page-dots{
        bottom: 0 !important;
        position: relative !important;
        margin-top: 20px;
    }

    .csm-image-carousel-{{ section.id }} .flickity-page-dots .dot{
        background: rgba(var(--color-button),var(--alpha-button-background)) !important;
        margin: 0 4px !important;
        border-radius: 50px !important;
        transition: 0.2s;
        opacity: 0.5 !important;
    }

    .csm-image-carousel-{{ section.id }} .flickity-page-dots .dot.is-selected{
        width: 30px !important;
        opacity: 1 !important;
    }

    @media (min-width: 769px) {
        .csm-image-carousel-{{ section.id }} .csm-image-carousel__cell {
            width: calc(100% / var(--desktop-columns));
        }
    }

    @media (max-width: 768px) {
        .csm-image-carousel-{{ section.id }} .csm-image-carousel__cell {
            width: calc(100% / var(--mobile-columns));
        }

        .csm-image-carousel-{{ section.id }}{
          padding: 0 1.5rem;
        }
    }
</style>

{% schema %}

{
  "name": "CSM Image Carousel",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
        "type": "select",
        "id": "navigation_style",
        "label": "Navigation Style",
        "default": "dots",
        "options": [
            { "value": "dots", "label": "Dots" },
            { "value": "arrows", "label": "Arrows" },
            { "value": "none", "label": "None" }
        ]
    },
    {
        "type": "select",
        "id": "alignment",
        "label": "Alignment",
        "default": "center",
        "options": [
            { "value": "center", "label": "Center" },
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
        ]
    },
    {
        "type": "range",
        "id": "desktop_columns",
        "label": "Desktop Columns",
        "min": 2,
        "max": 8,
        "step": 1,
        "default": 4
    },
    {
        "type": "range",
        "id": "mobile_columns",
        "label": "Mobile Columns",
        "min": 1,
        "max": 3,
        "step": 1,
        "default": 2
    },
    {
        "type": "range",
        "id": "cell_gap",
        "label": "Item Gap",
        "min": 0,
        "max": 40,
        "step": 2,
        "default": 10,
        "unit": "px"
    },
    {
        "type": "header",
        "content": "Image",
    },
    {
        "type": "range",
        "id": "border_radius",
        "label": "Border Radius",
        "min": 10,
        "max": 300,
        "step": 10,
        "default": 20
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "CSM Image Carousel"
    }
  ]
}

{% endschema %}