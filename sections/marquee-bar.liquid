{% if section.settings.enable_marquee %}

{% assign duration = 18 %}

{% if section.settings.marquee_speed == 'slow' %}
  {% assign duration = 30 %}
{% elsif section.settings.marquee_speed == 'medium' %}
  {% assign duration = 18 %}
{% elsif section.settings.marquee_speed == 'fast' %}
  {% assign duration = 10 %}
{% endif %}

<div class="marquee-section {{ section.settings.custom_class }}" style="--speed: {{ section.settings.marquee_speed }}; --duration: {{ duration }}s;">
  <ul class="marquee-wrapper">

  {% for i in (1..3) %}
    {% for block in section.blocks %}
      <li class="marquee-block">
        {% if block.settings.heading != blank %}
          <a href="{{ block.settings.link }}" class="marquee-link {% if section.settings.subtitle_uppercase %}uppercase{% endif %} size-{{ section.settings.text_size }}">
            {{ block.settings.heading }}
          </a>
        {% endif %}
      </li>
    {% endfor %}
  {% endfor %}

</ul>
</div>

<style>
.marquee-section {
  width: 100%;
  overflow: hidden;
  background: {{ section.settings.bg_color }};
  color: #fff;
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

.marquee-wrapper {
  display: flex;
  gap: 40px;
  width: max-content;
  animation: marqueeScroll var(--duration, 18s) linear infinite;
  margin: 0 !important;
}

.marquee-wrapper:hover {
  animation-play-state: paused;
}

.marquee-block {
  display: flex;
  align-items: center;
  gap: 10px;
  white-space: nowrap;
  width: calc(100% / 6);
  flex-shrink: 0;
}

.marquee-link {
  color: {{section.settings.text_color}};
  opacity: 1;
  display: inline-block;
  text-transform: capitalize;
  letter-spacing: {{ section.settings.letter_spacing }}px;
  transition: 0.3s;
}

.marquee-link:hover{
  color: {{section.settings.text_hover_color}};
}

.size-small {
  font-size: 12px;
}

.size-medium {
  font-size: 14px;
}

.size-large {
  font-size: 18px;
}

.uppercase{
  text-transform: uppercase;
}

@keyframes marqueeScroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}


@media (max-width: 480px){

  .marquee-block {
    width: calc(100% / 8);
  }

}
</style>

{% endif %}

{% schema %}
{
  "name": "Marquee Section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_marquee",
      "label": "Enable Marquee",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "checkbox",
      "id": "subtitle_uppercase",
      "label": "Uppercase",
      "default": false
    },
    {
      "type": "select",
      "id": "text_size",
      "label": "Text Size",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ]
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Text Letter Spacing",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 3
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_hover_color",
      "label": "Text Hover Color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "marquee_speed",
      "label": "Animation Speed",
      "default": "medium",
      "options": [
        {
          "value": "slow",
          "label": "Slow"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "fast",
          "label": "Fast"
        }
      ]
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 8
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class",
      "info": "Add your custom class name here"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Marquee Item",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Text",
          "default": "BLACK FRIDAY :10% OFF STOREWIDE"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee Section",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "heading": "USE CODE : BRAND20 ON CHECKOUT",
            "link": ""
          }
        },
        {
          "type": "item",
          "settings": {
            "heading": "FREE SHIPPING ON ORDERS ABOVE Rs.300",
            "link": ""
          }
        },
        {
          "type": "item",
          "settings": {
            "heading": "BLACK FRIDAY :10% OFF STOREWIDE",
            "link": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}