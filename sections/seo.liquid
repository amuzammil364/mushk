<section class="csm-seo-content-section">
    <div class="page-width">
        {% if section.settings.heading != blank %}
            <h2 class="csm-seo-content-heading">
                {{ section.settings.heading }}
            </h2>
        {% endif %}

        <div class="csm-seo-content-container" id="csm-seo-content-{{ section.id }}">
            {{ section.settings.content }}
        </div>

        <button class="button button--primary" type="button">
            Explore More
        </button>
    </div>
</section>

{% schema %}
{
  "name": "CSM SEO Content",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About Our Products"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    }
  ],
  "presets": [
    {
      "name": "CSM SEO Content"
    }
  ]
}
{% endschema %}