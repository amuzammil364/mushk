<section class="csm-seo-content-section">
    <div class="page-width">
        {% if section.settings.heading != blank %}
            <h2 class="csm-seo-content-heading">
                {{ section.settings.heading }}
            </h2>
        {% endif %}

        <div class="csm-seo-content-container" id="csm-seo-content-{{ section.id }}">
            {{ section.settings.content }}
        </div>

        <button class="button button--primary" type="button">
            Explore More
        </button>
    </div>
</section>

{% schema %}
{
  "name": "CSM SEO Content",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About Our Products"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading Letter Spacing",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_top_spacing",
      "label": "Heading Top Spacing",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_bottom_spacing",
      "label": "Heading Bottom Spacing",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Heading Uppercase Heading",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    }
  ],
  "presets": [
    {
      "name": "CSM SEO Content"
    }
  ]
}
{% endschema %}