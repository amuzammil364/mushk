<section class="csm-seo-content-section color-{{ section.settings.color_scheme }}">
    <div class="page-width">
        {% if section.settings.heading != blank %}
            <h2 class="csm-seo-content-heading">
                {{ section.settings.heading }}
            </h2>
        {% endif %}

        <div class="csm-seo-content-container" id="csm-seo-content-{{ section.id }}">
            {{ section.settings.content }}
        </div>

        <button class="button button--primary" type="button">
            Explore More
        </button>
    </div>
</section>

<style>

    .csm-seo-content-section{
        padding-top: {{section.settings.padding_top }}px;
        padding-bottom: {{section.settings.padding_bottom }}px;
    }

    .csm-seo-content-heading{
        text-align: {{ section.settings.heading_alignment }};
        letter-spacing: {{section.settings.heading_letter_spacing }}px;
        margin-top: {{ section.settings.heading_top_spacing }}px;
        margin-bottom: {{section.settings.heading_bottom_spacing }}px;
        text-transform: {% if section.settings.heading_uppercase %}uppercase;{% endif %}
    }

    .csm-seo-content-container{
        text-align: {{section.settings.content_alignment }};
        color: rgb(var(--color-foreground));
    }

    .csm-seo-content-container strong{
        font-weight: 700;
    }

</style>

{% schema %}
{
  "name": "CSM SEO Content",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About Our Products"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading Letter Spacing",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_top_spacing",
      "label": "Heading Top Spacing",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_bottom_spacing",
      "label": "Heading Bottom Spacing",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Heading Uppercase Heading",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "CSM SEO Content"
    }
  ]
}
{% endschema %}