<section class="csm-seo-content-section-{{ section.id }} color-{{ section.settings.color_scheme }}">
    <div class="csm-page-width">
        {% if section.settings.heading != blank %}
            <h2 class="csm-seo-content-heading">
                {{ section.settings.heading }}
            </h2>
        {% endif %}
        <div class="csm-seo-wrapper" id="csm-seo-wrapper-{{ section.id }}">
            <div class="csm-seo-content-container" id="csm-seo-content-{{ section.id }}">
                {{ section.settings.content }}
            </div>
            <div class="csm-seo-gradient-overlay"></div>
        </div>
        <div class="csm-seo-button-wrapper">
            <button class="button button--primary" type="button" id="SEO-Toggle-{{ section.id }}">
                Explore More
            </button>
        </div>
    </div>
</section>

{%- style -%}

    .csm-seo-content-section-{{ section.id }}{
        padding-top: {{section.settings.padding_top }}px;
        padding-bottom: {{section.settings.padding_bottom }}px;
    }

    .csm-seo-content-section-{{ section.id }} .csm-seo-content-heading{
        text-align: {{ section.settings.heading_alignment }};
        letter-spacing: {{section.settings.heading_letter_spacing }}px;
        margin-top: {{ section.settings.heading_top_spacing }}px;
        margin-bottom: {{section.settings.heading_bottom_spacing }}px;
        text-transform: {% if section.settings.heading_uppercase %}uppercase;{% endif %}
    }

    .csm-seo-content-section-{{ section.id }} .csm-seo-content-container{
        text-align: {{section.settings.content_alignment }};
        color: rgb(var(--color-foreground));
        margin-top: -18px;
    }

    .csm-seo-content-section-{{ section.id }} .csm-seo-content-container strong{
        font-weight: 700;
    }

    .csm-seo-content-section-{{ section.id }} .csm-page-width{
        text-align: {{section.settings.content_alignment }};
        margin: 0 auto;
        padding-right: 1.5rem;
        padding-left: 1.5rem;
        max-width: 86rem;
    }

    .csm-seo-content-section-{{ section.id }} .csm-seo-wrapper{
        position: relative;
        overflow: hidden;
        transition: max-height 0.6s ease-in-out;
        max-height: 350px;
    }

    .csm-seo-content-section-{{ section.id }} .csm-seo-wrapper.is-open .csm-seo-gradient-overlay{
        display: none !important;
    } 

    .csm-seo-content-section-{{ section.id }} .csm-seo-gradient-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 100px;
        background: linear-gradient(to bottom, rgba(255, 255, 255, 0), rgba(255, 255, 255, 1));
        transition: opacity 0.4s ease;
        pointer-events: none;
        z-index: 1;
        display: block !important;
    }

    .csm-seo-content-section-{{ section.id }} .csm-seo-button-wrapper{
        margin-top: 40px;
    }

{%- endstyle -%}

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = 'csm-seo-content-section-{{ section.id }}';
    const wrapper = document.getElementById('csm-seo-wrapper-{{ section.id }}');
    const container = wrapper.querySelector('.csm-seo-content-container');
    const toggleBtn = document.getElementById('SEO-Toggle-{{ section.id }}');
    
    const labelShow = 'Explore More';
    const labelHide = 'Show Less';
    const initialHeight = 350;

    if (toggleBtn && wrapper) {
      toggleBtn.addEventListener('click', function() {
        const isOpen = wrapper.classList.contains('is-open');
        
        if (!isOpen) {
          const fullHeight = container.scrollHeight;
          
          wrapper.style.maxHeight = fullHeight + "px";
          wrapper.classList.add('is-open');
          this.textContent = labelHide;
        } else {
          wrapper.style.maxHeight = initialHeight + "px";
          wrapper.classList.remove('is-open');
          this.textContent = labelShow;
          
          wrapper.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "CSM SEO Content",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About Our Products"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading Letter Spacing",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_top_spacing",
      "label": "Heading Top Spacing",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_bottom_spacing",
      "label": "Heading Bottom Spacing",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Heading Uppercase Heading",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "CSM SEO Content"
    }
  ]
}
{% endschema %}