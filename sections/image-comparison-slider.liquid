<div class="csm-compare csm-compare-{{ section.id }}">
  <div class="csm-compare-wrapper">

    <div class="csm-compare-before">
      {% if section.settings.before_image != blank %}
        <img src="{{ section.settings.before_image | image_url: width: 2000 }}">
      {% endif %}
    </div>

    <div class="csm-compare-after">
      {% if section.settings.after_image != blank %}
        <img src="{{ section.settings.after_image | image_url: width: 2000 }}">
      {% endif %}
    </div>

    <input type="range" min="0" max="100" value="50" class="csm-compare-slider">

    <div class="csm-handle"></div>
  </div>
</div>

<style>
    .csm-compare-wrapper {
        position: relative;
        width: 100%;
        overflow: hidden;
    }

    .csm-compare-before,
    .csm-compare-after {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
    }

    .csm-compare-before img,
    .csm-compare-after img {
        width: 100%;
        display: block;
    }

    .csm-compare-after {
        width: 50%;
        overflow: hidden;
    }

    .csm-compare-slider {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
    }

    .csm-handle {
        position: absolute;
        top: 0;
        left: 50%;
        width: 2px;
        height: 100%;
        background: #fff;
        transform: translateX(-50%);
        pointer-events: none;
    }
</style>

{% schema %}

{
  "name": "Image Comparison Slider",
  "settings": [
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before Image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After Image"
    }
  ],
  "presets": [
    {
      "name": "Image Comparison Slider"
    }
  ]
}

{% endschema %}