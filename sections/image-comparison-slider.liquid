<div class="csm-compare csm-compare-{{ section.id }}">
  <div class="csm-compare-wrapper">

    <div class="csm-base">
      {% if section.settings.before_image != blank %}
        <img src="{{ section.settings.before_image | image_url: width: 2000 }}">
      {% endif %}
    </div>

    <div class="csm-overlay">
      {% if section.settings.after_image != blank %}
        <img src="{{ section.settings.after_image | image_url: width: 2000 }}">
      {% endif %}
    </div>

    <div class="csm-handle"></div>
  </div>
</div>

<style>
    .csm-compare-wrapper {
    position: relative;
    width: 100%;
    height: 450px;
    overflow: hidden;
    user-select: none;
    }

    .csm-base img,
    .csm-overlay img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    }

    .csm-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    clip-path: inset(0 50% 0 0);
    }

    .csm-handle {
    position: absolute;
    top: 0;
    left: 50%;
    width: 3px;
    height: 100%;
    background: #fff;
    transform: translateX(-50%);
    cursor: grab;
    }

    .csm-handle:active {
    cursor: grabbing;
    }
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {

  document.querySelectorAll(".csm-compare").forEach(section => {

    const wrapper = section.querySelector(".csm-compare-wrapper");
    const overlay = section.querySelector(".csm-overlay");
    const handle = section.querySelector(".csm-handle");

    let isDragging = false;

    function move(x) {
      const rect = wrapper.getBoundingClientRect();
      let percent = ((x - rect.left) / rect.width) * 100;

      if (percent < 0) percent = 0;
      if (percent > 100) percent = 100;

      overlay.style.clipPath = `inset(0 ${100 - percent}% 0 0)`;
      handle.style.left = percent + "%";
    }

    wrapper.addEventListener("mousedown", () => isDragging = true);
    window.addEventListener("mouseup", () => isDragging = false);

    window.addEventListener("mousemove", (e) => {
      if (!isDragging) return;
      move(e.clientX);
    });

    // mobile touch support
    wrapper.addEventListener("touchstart", () => isDragging = true);
    window.addEventListener("touchend", () => isDragging = false);

    window.addEventListener("touchmove", (e) => {
      if (!isDragging) return;
      move(e.touches[0].clientX);
    });

    // initial center
    move(wrapper.getBoundingClientRect().left + wrapper.offsetWidth / 2);

  });

});
</script>

{% schema %}

{
  "name": "Image Comparison Slider",
  "settings": [
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before Image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After Image"
    }
  ],
  "presets": [
    {
      "name": "Image Comparison Slider"
    }
  ]
}

{% endschema %}