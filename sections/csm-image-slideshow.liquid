{{ 'flickity.min.css' | asset_url | stylesheet_tag }}

<style>
    .csm-image-flickity-slider {
        width: 100%;
        overflow: hidden;
        position: relative;
    }

    .csm-image-flickity-slider .csm-image-carousel-cell {
        width: 100%;
        margin-right: 0;
    }

    .csm-image-flickity-slider .csm-image-carousel-cell img{
        width: 100%;
        display: block;
    }

    .mobile-img {
        display: none !important;
    }

    .csm-image-flickity-slider .flickity-button{
        display: block !important;
        background: white !important;
    }

    .csm-image-flickity-slider .flickity-button:active{
        opacity: 1 !important;
    }

    .csm-image-flickity-slider .flickity-button:focus{
        box-shadow: none !important;
    }

    .csm-image-flickity-slider .flickity-prev-next-button{
        width: 40px !important;
        height: 40px !important;
    }

    .csm-image-flickity-slider .flickity-prev-next-button .flickity-button-icon{
        left: 26%;
        top: 26%;
        width: 46%;
        height: 46%;
    }

    @media (max-width: 465px) {
        .desktop-img {
            display: none !important;
        }

        .mobile-img {
            display: block !important;
        }

        .csm-image-carousel-cell {
            height: {{ section.settings.mobile_height }}px;
        }

        .csm-image-carousel-cell img {
            height: 100%;
            object-fit: cover;
        }
    }
</style>

<div class="csm-image-flickity-slider">
  {% for block in section.blocks %}
    <a class="csm-image-carousel-cell" href="{{ block.settings.link }}">
        {% if block.settings.image != blank %}
            <img
                class="desktop-img"
                src="{{ block.settings.image | image_url: width: 2000 }}"
            >
        {% endif %}

        {% if block.settings.mobile_image != blank %}
            <img
                class="mobile-img"
                src="{{ block.settings.mobile_image | image_url: width: 1000 }}"
            >
            {% endif %}
    </a>
  {% endfor %}
</div>

{% assign show_arrows = false %}
{% assign show_dots = true %}

{% if section.settings.navigation_style == 'arrows' %}
  {% assign show_arrows = true %}
  {% assign show_dots = false %}
{% elsif section.settings.navigation_style == 'none' %}
  {% assign show_arrows = false %}
  {% assign show_dots = false %}
{% endif %}

<script
  src="{{ 'flickity.pkgd.min.js' | asset_url }}"
  defer
></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  new Flickity('.csm-image-flickity-slider', {
    wrapAround: true,
    autoPlay: 3000,
    pauseAutoPlayOnHover: true,
    prevNextButtons: {{ show_arrows }},
    pageDots: {{ show_dots }},
    draggable: true,
  });
});
</script>

{% schema %}
{
  "name": "CSM Image Slideshow",
  "settings": [
    {
        "type": "select",
        "id": "navigation_style",
        "label": "Navigation Style",
        "default": "dots",
        "options": [
            { "value": "dots", "label": "Dots" },
            { "value": "arrows", "label": "Arrows" },
            { "value": "none", "label": "None" }
        ]
    },
    {
        "type": "range",
        "id": "mobile_height",
        "label": "Mobile Image Height",
        "min": 200,
        "max": 800,
        "step": 10,
        "default": 400,
        "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
            "type": "url",
            "id": "link",
            "label": "Link"
        },
        {
            "type": "image_picker",
            "id": "image",
            "label": "Desktop Image"
        },
        {
            "type": "image_picker",
            "id": "mobile_image",
            "label": "Mobile Image"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "CSM Image Slideshow"
    }
  ]
}
{% endschema %}