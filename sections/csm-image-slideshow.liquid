{{ 'flickity.min.css' | asset_url | stylesheet_tag }}

<style>
  .csm-image-flickity-slider {
    width: 100%;
    overflow: hidden;
  }

  .csm-image-flickity-slider .csm-image-carousel-cell {
    width: 100%;
    margin-right: 0;
  }

  .csm-image-flickity-slider .csm-image-carousel-cell img{
    width: 100%;
  }
</style>

<div class="csm-image-flickity-slider">
  {% for block in section.blocks %}
    <div class="csm-image-carousel-cell">
        {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 2000 }}" alt="Banner Slide Image" />
            {% endif %}
    </div>
  {% endfor %}
</div>

<script
  src="{{ 'flickity.pkgd.min.js' | asset_url }}"
  defer
></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  new Flickity('.csm-image-flickity-slider', {
    wrapAround: true,
    autoPlay: 3000,
    pauseAutoPlayOnHover: true,
    prevNextButtons: false,
    pageDots: true,
    draggable: true
  });
});
</script>

{% schema %}
{
  "name": "CSM Image Slideshow",
  "settings": [
    {
        "type": "select",
        "id": "navigation_style",
        "label": "Navigation Style",
        "default": "dots",
        "options": [
            { "value": "dots", "label": "Dots" },
            { "value": "arrows", "label": "Arrows" },
            { "value": "none", "label": "None" }
        ]
    },
    {
        "type": "range",
        "id": "mobile_height",
        "label": "Mobile Image Height",
        "min": 200,
        "max": 800,
        "step": 10,
        "default": 400,
        "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
        "type": "image_picker",
        "id": "image",
        "label": "Image"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "CSM Image Slideshow"
    }
  ]
}
{% endschema %}