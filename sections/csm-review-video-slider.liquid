{{ 'flickity.min.css' | asset_url | stylesheet_tag }}

<div class="csm-review-slider csm-review-slider-{{ section.id }}">
    <div class="csm-review-slider-container">
        {%- if section.settings.title != blank -%}
            <h2 class="title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" style="
            text-align: {{ section.settings.heading_alignment }};
            letter-spacing: {{ section.settings.heading_letter_spacing }}px;
            margin-top: {{ section.settings.heading_top_spacing }}px;
            margin-bottom: {{ section.settings.heading_bottom_spacing }}px;
            {% if section.settings.heading_uppercase %}text-transform: uppercase;{% endif %}
            ">
            {{ section.settings.title }}
            </h2>
        {%- endif -%}
        <div class="csm-review-slider-wrapper-{{ section.id }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            {% for block in section.blocks %}
                {% assign product = block.settings.product %}

                <div class="csm-review-slide">

                    <div class="csm-review-video">
                    {% if block.settings.video_url != blank %}
                        <video controls playsinline>
                        <source src="{{ block.settings.video_url }}" type="video/mp4">
                        </video>
                    {% endif %}
                    </div>

                    <div class="csm-review-bottom">

                    {% if product != blank %}
                        <a href="{{ product.url }}" class="csm-review-product">
                        <img src="{{ product.featured_image | image_url: width: 200 }}" alt="">
                        </a>
                    {% endif %}

                    <div class="csm-review-content">
                        {% if product != blank %}
                        <a href="{{ product.url }}">
                            <h3>{{ product.title }}</h3>
                        </a>

                        <p>{{ product.price | money }}</p>
                        {% endif %}

                        {% if block.settings.text != blank %}
                        <span class="review-text">{{ block.settings.text }}</span>
                        {% endif %}
                    </div>

                    </div>

                </div>
            {% endfor %}
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {

  const isMobile = window.innerWidth < 768;

  new Flickity('.csm-review-slider-{{ section.id }}', {
    cellAlign: 'left',
    contain: true,
    wrapAround: true,
    pageDots: true,
    prevNextButtons: false,
    draggable: true,

    groupCells: isMobile
      ? {{ section.settings.mobile_columns }}
      : {{ section.settings.desktop_columns }}
  });

});
</script>

<style>
    .csm-review-slider-{{ section.id }}{
        padding-top: {{section.settings.padding_top }}px;
        padding-bottom: {{section.settings.padding_bottom }}px;
        width: 100%;
    }

    .csm-review-slider-{{ section.id }} .csm-review-slide {
        width: 100%;
        margin-right: 20px;
        border-radius: 12px;
        overflow: hidden;
    }

    .csm-review-video video {
        width: 100%;
        display: block;
        aspect-ratio: 9/16;
        object-fit: cover;
    }

    .csm-review-bottom {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
    }

    .csm-review-product img {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        object-fit: cover;
    }

    .csm-review-content h3 {
        margin: 0;
        font-size: 14px;
    }

    .review-text {
        font-size: 12px;
        opacity: 0.7;
    }
</style>

{%  schema %}

{
  "name": "Review Video Slider",
  "settings": [
    {
        "type": "select",
        "id": "navigation_style",
        "label": "Navigation Style",
        "default": "dots",
        "options": [
            { "value": "dots", "label": "Dots" },
            { "value": "arrows", "label": "Arrows" },
            { "value": "none", "label": "None" }
        ]
    },
    {
        "type": "range",
        "id": "desktop_columns",
        "label": "Desktop Columns",
        "min": 2,
        "max": 8,
        "step": 1,
        "default": 4
    },
    {
        "type": "range",
        "id": "mobile_columns",
        "label": "Mobile Columns",
        "min": 1,
        "max": 3,
        "step": 1,
        "default": 2
    },
    {
        "type": "range",
        "id": "cell_gap",
        "label": "Item Gap",
        "min": 0,
        "max": 40,
        "step": 2,
        "default": 10,
        "unit": "px"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Title",
      "label": "Title"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading Letter Spacing",
      "min": 0,
      "max": 10,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_top_spacing",
      "label": "Heading Top Spacing",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_bottom_spacing",
      "label": "Heading Bottom Spacing",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "heading_uppercase",
      "label": "Heading Uppercase Heading",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "url",
          "id": "video_url",
          "label": "Video URL"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Review Video Slider"
    }
  ]
}

{% endschema %}