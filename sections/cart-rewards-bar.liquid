<div class="reward-bar">
  <div class="reward-message">Loading rewards...</div>

  <div class="reward-progress">
    <div class="reward-progress-fill"></div>
  </div>

  <div class="reward-steps">
    <div class="step">
      <span>🚚</span>
      <p>2+ Items<br>Free Shipping</p>
    </div>

    <div class="step">
      <span>🎁</span>
      <p>5+ Items<br>5% OFF</p>
    </div>

    <div class="step">
      <span>🏆</span>
      <p>8+ Items<br>10% OFF</p>
    </div>
  </div>
</div>

<style>
.reward-bar.show {
  display: block;
}

.reward-bar.hidden {
  display: none;
}

.reward-bar{
  display: none;
}

.reward-message{
  font-size:14px;
  font-weight:600;
  margin-bottom:10px;
}

.reward-progress{
  width:100%;
  height:10px;
  background:#eee;
  border-radius:50px;
  overflow:hidden;
}

.reward-progress-fill{
  width:0%;
  height:100%;
  background:linear-gradient(90deg,#000,#444);
  transition:0.3s ease;
}

.reward-steps{
  display:flex;
  justify-content:space-between;
  margin-top:12px;
  text-align:center;
}

.reward-steps .step{
  font-size:12px;
  width:33%;
}

.reward-steps span{
  font-size:18px;
  display:block;
  margin-bottom:5px;
}
</style>

<script>
(function () {

  const REWARD_BAR_SELECTOR = {
    message: '.reward-message',
    fill: '.reward-progress-fill'
  };

  async function updateRewardBar() {

    try {
        const res = await fetch('/cart.js', {
            headers: {
            'Cache-Control': 'no-cache'
            }
        });

        const cart = await res.json();
        const qty = cart.item_count;

        const bar = document.querySelector('.reward-bar');

        if (!bar) return;

        bar.classList.add('show');

        if (qty === 0) {
            bar.classList.remove('show');
            bar.classList.add('hidden');
            return;
        }

        bar.classList.remove('hidden');

        let percent = 0;
        let message = '';

        console.log("Reward Bar Updated | Qty:", qty);

        if (qty < 2) {
            percent = (qty / 2) * 25;
            message = `Buy ${2 - qty} more to get Free Shipping`;
        }

        else if (qty < 5) {
            percent = 25 + ((qty - 2) / 3) * 25;
            message = `Buy ${5 - qty} more to get 5% OFF🤩`;
        }

        else if (qty < 8) {
            percent = 50 + ((qty - 5) / 3) * 25;
            message = `Buy ${8 - qty} more to get 10% OFF🤩`;
        }

        else {
            percent = 100;
            message = `🏆 Amazing! 10% OFF unlocked`;
        }

        const msgEl = document.querySelector(REWARD_BAR_SELECTOR.message);
        const fillEl = document.querySelector(REWARD_BAR_SELECTOR.fill);

        if (msgEl) msgEl.innerHTML = message;
        if (fillEl) fillEl.style.width = percent + '%';

        } catch (err) {
        console.error('Reward Bar Error:', err);
        }
  }

  let timeout;
  function debounceUpdate() {
    clearTimeout(timeout);
    timeout = setTimeout(updateRewardBar, 300);
  }

  document.addEventListener('DOMContentLoaded', updateRewardBar);

  setInterval(updateRewardBar, 3000);

  const originalFetch = window.fetch;

  window.fetch = async function () {

    const response = await originalFetch.apply(this, arguments);

    const url = arguments[0];

    if (typeof url === 'string' && (
      url.includes('/cart/add') ||
      url.includes('/cart/change') ||
      url.includes('/cart/update') ||
      url.includes('/cart/clear')
    )) {
      debounceUpdate();
    }

    return response;
  };

  document.addEventListener('change', function (e) {
    if (e.target && e.target.name && e.target.name.includes('quantity')) {
      debounceUpdate();
    }
  });

})();
</script>

{% schema %}
{
  "name": "Reward Progress Bar",
  "settings": [],
  "presets": [
    {
      "name": "Reward Progress Bar"
    }
  ]
}
{% endschema %}