{% if settings.enable_reward_bar %}
<div class="reward-bar hidden color-{{ section.settings.color_scheme }}" data-reward-bar-{{ section.id }}>
  <div class="reward-bar-container">

    <div class="reward-message">Loading rewards...</div>

    <div class="reward-progress">
      <div class="reward-progress-fill"></div>
    </div>

    <div class="reward-steps">

      <!-- STEP 1 -->
      <div class="step" data-step="{{ settings.reward_step1_value }}">
        <div class="circle-step">
          <span class="trigger">{{ settings.reward_step1_value }}</span>
          <span class="icon">
            {% if settings.reward_step1_icon %}
              <img src="{{ settings.reward_step1_icon | image_url: width: 100 }}" />
            {% endif %}
          </span>
        </div>
        <p>
          {{ settings.reward_step1_label }}
        </p>
      </div>

      <!-- STEP 2 -->
      <div class="step" data-step="{{ settings.reward_step2_value }}">
        <div class="circle-step">
          <span class="trigger">{{ settings.reward_step2_value }}</span>
          <span class="icon">
            {% if settings.reward_step2_icon %}
              <img src="{{ settings.reward_step2_icon | image_url: width: 100 }}" />
            {% endif %}
          </span>
        </div>
        <p>
          {{ settings.reward_step2_label }}
        </p>
      </div>

      <!-- STEP 3 -->
      <div class="step" data-step="{{ settings.reward_step3_value }}">
        <div class="circle-step">
          <span class="trigger">{{ settings.reward_step3_value }}</span>
          <span class="icon">
            {% if settings.reward_step3_icon %}
              <img src="{{ settings.reward_step3_icon | image_url: width: 100 }}" />
            {% endif %}
          </span>
        </div>
        <p>
          {{ settings.reward_step3_label }}
        </p>
      </div>

    </div>
  </div>
</div>

<style> 
  
.reward-bar.show {
  display: block;
}
.reward-bar.hidden {
  display: none;
}
.reward-bar{
  display: none;
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

.reward-message{
  width: 100%;
  text-align: center;
  margin-bottom: 60px;
}

.reward-bar-container{
  {% if section.settings.full_width %}
  width: 100%;
  max-width: 100%;
  {% else %}
  max-width: var(--page-width);
  margin: 0 auto;
  padding: 0 5rem;
  {% endif %}
}
.reward-progress{
  width: 100%;
  height: 10px;
  background: #eee;
  border-radius: 50px;
  overflow: hidden;
}
.reward-progress-fill{
  width: 0%;
  height: 100%;
  background: #000;
  transition: 0.3s ease;
  display: block !important;
}
.reward-steps{
    display:flex;
    justify-content:space-between;
}
.reward-steps .step:nth-child(1){
    width: 32%;
}
.reward-steps .step:nth-child(2){
    width: 20%;
}
.reward-steps .step:nth-child(3){
    width: 48%;
}
.reward-steps .step{
    font-size: 12px;
    width: 33.33%;
    display: flex;
    flex-direction: column;
    align-items: end;
    margin-top: -46px;
    transition:  0.3s;
}

.reward-steps .step .circle-step .trigger{
  width: 100%;
  text-align: center;
  font-size: 12px;
  display: block;
}

.reward-steps .step .circle-step .icon{
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #fff;
  padding: 5px;
  border: 2px solid rgb(221, 221, 221);
  width: 41px;
  height: 41px;
}

.reward-steps .step.active .circle-step .icon{
  border: 2px solid #000;
}

.reward-steps .step .circle-step .icon img{
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.reward-steps .step p{
  font-size: 11px;
  margin-top: 4px !important;
  margin-bottom: 0 !important;
}

.reward-steps .step:nth-child(1) p{
  margin-right: -14px;
}

.reward-steps .step:nth-child(3) p{
  margin-right: -4px;
}
 </style>

<script>
(function () {

  async function updateRewardBar() {

    try {
      const res = await fetch('/cart.js');
      const cart = await res.json();

      const bar = document.querySelector('[data-reward-bar-{{ section.id }}]');
      if (!bar) return;

      const msgEl = bar.querySelector('.reward-message');
      const fillEl = bar.querySelector('.reward-progress-fill');

      const rewardType = "{{ settings.reward_type }}";

      const step1 = {{ settings.reward_step1_value }};
      const step2 = {{ settings.reward_step2_value }};
      const step3 = {{ settings.reward_step3_value }};

      const value = rewardType === 'quantity'
        ? cart.item_count
        : cart.total_price / 100;

      if (cart.item_count === 0) {
        bar.classList.add('hidden');
        return;
      }

      bar.classList.remove('hidden');
      bar.classList.add('show');

      let percent = 0;
      let message = '';

      if (value < step1) {
        percent = (value / step1) * 32;
        message = `Buy ${step1 - value} more to unlock Free Shipping`;
      }
      else if (value < step2) {
        percent = 32 + ((value - step1) / (step2 - step1)) * 20;
        message = `🎉 Free Shipping unlocked! Buy ${step2 - value} more for 5% OFF`;
      }
      else if (value < step3) {
        percent = 52 + ((value - step2) / (step3 - step2)) * 48;
        message = `🔥 5% OFF unlocked! Buy ${step3 - value} more for 10% OFF`;
      }
      else {
        percent = 100;
        message = `🏆 You unlocked all rewards!`;
      }

      fillEl.style.width = Math.min(100, Math.max(0, percent)) + '%';
      msgEl.innerHTML = message;

      const steps = bar.querySelectorAll('.step');

      steps.forEach(step => {
        const stepValue = parseFloat(step.getAttribute('data-step'));

        if (value >= stepValue) {
          step.classList.add('active');
        } else {
          step.classList.remove('active');
        }
      });

    } catch (err) {
      console.error('Reward Bar Error:', err);
    }
  }

  document.addEventListener('DOMContentLoaded', updateRewardBar);

  setInterval(updateRewardBar, 5000);

  const originalFetch = window.fetch;

  window.fetch = async function () {
    const response = await originalFetch.apply(this, arguments);

    const url = arguments[0];

    if (typeof url === 'string' && url.includes('/cart')) {
      setTimeout(updateRewardBar, 300);
    }

    return response;
  };

})();
</script>

{% endif %}

{% schema %}
{
  "name": "Reward Progress Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.rich-text.settings.full_width.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Left",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Right",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Reward Progress Bar"
    }
  ]
}
{% endschema %}