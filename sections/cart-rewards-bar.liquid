<div class="reward-bar">
    <div class="reward-bar-container">
        <div class="reward-message">Loading rewards...</div>

        <div class="reward-progress">
            <div class="reward-progress-fill"></div>
        </div>

        <div class="reward-steps">
            <div class="step">
                <span>🚚</span>
                <p>2+ Items<br>Free Shipping</p>
            </div>

            <div class="step">
                <span>🎁</span>
                <p>5+ Items<br>5% OFF</p>
            </div>

            <div class="step">
                <span>🏆</span>
                <p>8+ Items<br>10% OFF</p>
            </div>
        </div>
    </div>
</div>

<style>
.reward-bar.show {
  display: block;
}

.reward-bar.hidden {
  display: none;
}

.reward-bar{
  display: none;
}

.reward-bar-container{
    {% if section.settings.full_width %}
        width: 100%;
        max-width: 100%;
    {% else %}
        max-width: var(--page-width);
        margin: 0 auto;
        padding: 0 5rem;
    {% endif %}
}

.reward-progress{
  width: 100%;
  height: 10px;
  background: #eee;
  border-radius: 50px;
  overflow: hidden;
}

.reward-progress-fill{
  width: 0%;
  height: 100%;
  background: #000;
  transition: 0.3s ease;
  display: block !important;
}

.reward-steps{
  display:flex;
  justify-content:space-between;
  text-align:center;
}

.reward-steps .step{
  font-size: 12px;
  width: 33%;
}

.reward-steps span{
  font-size: 18px;
  display: block;
  margin-bottom: 5px;
}
</style>

<script>
(function () {

  const REWARD_BAR_SELECTOR = {
    message: '.reward-message',
    fill: '.reward-progress-fill'
  };

  async function updateRewardBar() {

    try {
        const res = await fetch('/cart.js', {
            headers: {
            'Cache-Control': 'no-cache'
            }
        });

        const cart = await res.json();
        const qty = cart.item_count;

        const bar = document.querySelector('.reward-bar');

        if (!bar) return;

        bar.classList.add('show');

        if (qty === 0) {
            bar.classList.remove('show');
            bar.classList.add('hidden');
            return;
        }

        bar.classList.remove('hidden');

        let percent = 0;
        let message = '';
        const step1 = 2;
        const step2 = 5;
        const step3 = 8;

        console.log("Reward Bar Updated | Qty:", qty);

        if (qty < step1) {

  percent = (qty / step1) * 33;

  message = `Buy ${step1 - qty} more to get Free Shipping`;
}

// 🟢 STEP 2: 2 - 4 items
else if (qty < step2) {

  percent = 33 + ((qty - step1) / (step2 - step1)) * 33;

  message = `🎉 Free Shipping unlocked! Buy ${step2 - qty} more → 5% OFF`;
}

// 🔵 STEP 3: 5 - 7 items
else if (qty < step3) {

  percent = 66 + ((qty - step2) / (step3 - step2)) * 34;

  message = `🔥 5% OFF unlocked! Buy ${step3 - qty} more → 10% OFF`;
}

// 🏆 FINAL
else {

  percent = 100;

  message = `🏆 10% OFF unlocked`;
}

        percent = Math.max(0, Math.min(100, percent));

        const msgEl = document.querySelector(REWARD_BAR_SELECTOR.message);
        const fillEl = document.querySelector(REWARD_BAR_SELECTOR.fill);

        if (msgEl) msgEl.innerHTML = message;
        if (fillEl) fillEl.style.width = percent + '%';

        } catch (err) {
        console.error('Reward Bar Error:', err);
        }
  }

  let timeout;
  function debounceUpdate() {
    clearTimeout(timeout);
    timeout = setTimeout(updateRewardBar, 300);
  }

  document.addEventListener('DOMContentLoaded', updateRewardBar);

  setInterval(updateRewardBar, 3000);

  const originalFetch = window.fetch;

  window.fetch = async function () {

    const response = await originalFetch.apply(this, arguments);

    const url = arguments[0];

    if (typeof url === 'string' && (
      url.includes('/cart/add') ||
      url.includes('/cart/change') ||
      url.includes('/cart/update') ||
      url.includes('/cart/clear')
    )) {
      debounceUpdate();
    }

    return response;
  };

  document.addEventListener('change', function (e) {
    if (e.target && e.target.name && e.target.name.includes('quantity')) {
      debounceUpdate();
    }
  });

})();
</script>

{% schema %}
{
  "name": "Reward Progress Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.rich-text.settings.full_width.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Reward Progress Bar"
    }
  ]
}
{% endschema %}