<div class="reward-bar hidden" data-reward-bar-{{ section.id }}>
  <div class="reward-bar-container">

    <div class="reward-message">Loading rewards...</div>

    <div class="reward-progress">
      <div class="reward-progress-fill"></div>
    </div>

    <div class="reward-steps">

      <!-- STEP 1 -->
      <div class="step">
        <span>
          {% if settings.reward_step1_icon %}
            <img src="{{ settings.reward_step1_icon | image_url: width: 40 }}" />
          {% endif %}
        </span>
        <p>
          {{ settings.reward_step1_value }}+
          {% if settings.reward_type == 'quantity' %} Items {% else %} Rs {% endif %}
          <br>
          {{ settings.reward_step1_label }}
        </p>
      </div>

      <!-- STEP 2 -->
      <div class="step">
        <span>
          {% if settings.reward_step2_icon %}
            <img src="{{ settings.reward_step2_icon | image_url: width: 40 }}" />
          {% endif %}
        </span>
        <p>
          {{ settings.reward_step2_value }}+
          {% if settings.reward_type == 'quantity' %} Items {% else %} Rs {% endif %}
          <br>
          {{ settings.reward_step2_label }}
        </p>
      </div>

      <!-- STEP 3 -->
      <div class="step">
        <span>
          {% if settings.reward_step3_icon %}
            <img src="{{ settings.reward_step3_icon | image_url: width: 40 }}" />
          {% endif %}
        </span>
        <p>
          {{ settings.reward_step3_value }}+
          {% if settings.reward_type == 'quantity' %} Items {% else %} Rs {% endif %}
          <br>
          {{ settings.reward_step3_label }}
        </p>
      </div>

    </div>
  </div>
</div>

<style>
.reward-bar.hidden { display: none; }
.reward-bar.show { display: block; }

.reward-bar-container{
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px;
}

.reward-progress{
  width: 100%;
  height: 10px;
  background: #eee;
  border-radius: 50px;
  overflow: hidden;
  margin: 10px 0;
}

.reward-progress-fill{
  width: 0%;
  height: 100%;
  background: #000;
  transition: 0.3s ease;
}

.reward-steps{
  display: flex;
  justify-content: space-between;
  text-align: center;
  font-size: 12px;
}

.reward-steps .step{
  width: 33%;
}

.reward-steps img{
  width: 22px;
  height: 22px;
  margin-bottom: 5px;
}
</style>

<script>
(function () {

  async function updateRewardBar() {

    try {
      const res = await fetch('/cart.js');
      const cart = await res.json();

      const bar = document.querySelector('[data-reward-bar-{{ section.id }}]');
      if (!bar) return;

      const msgEl = bar.querySelector('.reward-message');
      const fillEl = bar.querySelector('.reward-progress-fill');

      const rewardType = "{{ settings.reward_type }}";

      const step1 = {{ settings.reward_step1_value }};
      const step2 = {{ settings.reward_step2_value }};
      const step3 = {{ settings.reward_step3_value }};

      const value = rewardType === 'quantity'
        ? cart.item_count
        : cart.total_price / 100;

      if (cart.item_count === 0) {
        bar.classList.add('hidden');
        return;
      }

      bar.classList.remove('hidden');
      bar.classList.add('show');

      let percent = 0;
      let message = '';

      if (value < step1) {
        percent = (value / step1) * 33;
        message = `Buy ${step1 - value} more to unlock Free Shipping`;
      }
      else if (value < step2) {
        percent = 33 + ((value - step1) / (step2 - step1)) * 33;
        message = `🎉 Free Shipping unlocked! Buy ${step2 - value} more for 5% OFF`;
      }
      else if (value < step3) {
        percent = 66 + ((value - step2) / (step3 - step2)) * 34;
        message = `🔥 5% OFF unlocked! Buy ${step3 - value} more for 10% OFF`;
      }
      else {
        percent = 100;
        message = `🏆 You unlocked all rewards!`;
      }

      fillEl.style.width = Math.min(100, Math.max(0, percent)) + '%';
      msgEl.innerHTML = message;

    } catch (err) {
      console.error('Reward Bar Error:', err);
    }
  }

  document.addEventListener('DOMContentLoaded', updateRewardBar);

  setInterval(updateRewardBar, 5000);

  const originalFetch = window.fetch;

  window.fetch = async function () {
    const response = await originalFetch.apply(this, arguments);

    const url = arguments[0];

    if (typeof url === 'string' && url.includes('/cart')) {
      setTimeout(updateRewardBar, 300);
    }

    return response;
  };

})();
</script>

{% schema %}
{
  "name": "Reward Progress Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.rich-text.settings.full_width.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Reward Progress Bar"
    }
  ]
}
{% endschema %}