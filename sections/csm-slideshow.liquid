{{ 'flickity.min.css' | asset_url | stylesheet_tag }}

<style>
  .csm-flickity-slider {
    width: 100%;
    overflow: hidden;
  }

  .csm-flickity-slider .carousel-cell {
    width: 100%;
    margin-right: 0;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  .csm-slide__content {
    max-width: 600px;
    padding-left: 10%;
  }

  .csm-flickity-slider .flickity-viewport {
    cursor: grab;
  }

  .csm-flickity-slider .flickity-viewport:active {
    cursor: grabbing;
  }

  .flickity-button {
    display: none !important;
  }

  .flickity-page-dots {
    bottom: 0;
    line-height: 0;
  }

  .flickity-page-dots .dot {
    width: 80px;
    height: 6px;
    opacity: 0.4;
    border-radius: 0;
    background: #fff !important;
  }

  .flickity-page-dots .dot.is-selected {
    opacity: 1;
  }
</style>

<div class="csm-flickity-slider">
  {% for block in section.blocks %}
    <div class="carousel-cell" id="carousel-cell-{{ block.id }}" style="
      background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)),
      url('{{ block.settings.image | image_url: width: 2000 }}');
      ">
      <div class="csm-slide__content">
        {% if block.settings.heading != blank %}
          <h2>{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <p>{{ block.settings.text }}</p>
        {% endif %}

        {% if block.settings.button_label != blank %}
          <a href="{{ block.settings.button_link }}" class="csm-slide__button">
            {{ block.settings.button_label }}
          </a>
        {% endif %}
      </div>
      <style>
        #carousel-cell-{{ block.id }}{
          padding-top: {{block.settings.desktop_padding_top }}px;
          padding-bottom: {{block.settings.desktop_padding_bottom }}px;
        }
      </style>
    </div>
  {% endfor %}
</div>

<script
  src="{{ 'flickity.pkgd.min.js' | asset_url }}"
  defer
></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  new Flickity('.csm-flickity-slider', {
    wrapAround: true,
    autoPlay: 3000,
    pauseAutoPlayOnHover: true,
    prevNextButtons: false,
    pageDots: true,
    draggable: true
  });
});
</script>

{% schema %}
{
  "name": "CSM Slideshow",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "color_background",
          "id": "overlay_gradient",
          "label": "Overlay gradient",
          "default": "linear-gradient(180deg, rgba(0,0,0,0.5), rgba(0,0,0,0.2))"
        },
        {
        "type": "image_picker",
        "id": "image",
        "label": "Background image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "header",
          "content": "Padding",
        },
        {
          "type": "range",
          "id": "desktop_padding_top",
          "min": 0,
          "max": 150,
          "step": 2,
          "unit": "px",
          "label": "Desktop Padding Top",
          "default": 80
        },
        {
          "type": "range",
          "id": "desktop_padding_bottom",
          "min": 0,
          "max": 150,
          "step": 2,
          "unit": "px",
          "label": "Desktop Padding Bottom",
          "default": 80
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "CSM Slideshow"
    }
  ]
}
{% endschema %}