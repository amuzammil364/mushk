{{ 'flickity.min.css' | asset_url | stylesheet_tag }}

<style>
  .csm-flickity-slider {
    width: 100%;
    overflow: hidden;
  }

  .csm-flickity-slider .carousel-cell {
    width: 100%;
    margin-right: 0;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    padding-left: 12%;
    padding-right: 12%;
  }

  .csm-slide__content{
    display: flex;
    flex-direction: column;
    align-items: {{section.settings.section_desktop_alignment}};
    text-align: {{section.settings.section_desktop_alignment}};
  }

  .csm-slide__content h2{
    color: rgb(var(--color-foreground)); 
  }

  .csm-slide__content p{
    color: rgb(var(--color-foreground));
  }

  .csm-flickity-slider .flickity-viewport {
    cursor: grab;
  }

  .csm-flickity-slider .flickity-viewport:active {
    cursor: grabbing;
  }

  .flickity-button {
    display: none !important;
  }

  .flickity-page-dots {
    bottom: 0;
    line-height: 0;
  }

  .flickity-page-dots .dot {
    width: 80px;
    height: 6px;
    opacity: 0.4;
    border-radius: 0;
    background: #fff !important;
  }

  .flickity-page-dots .dot.is-selected {
    opacity: 1;
  }

  .csm-slide__button{
    font-size: 1.6rem;
    letter-spacing: .3rem;
    background-color: rgba(var(--color-button));
    text-transform: uppercase;
    color: rgb(var(--color-button-text));
    text-decoration: none;
    min-height: calc(4.5rem + var(--buttons-border-width) * 2);
    padding: 0 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: max-content;
    border-radius: var(--buttons-radius-outset);
  }

  @media (max-width: 768px){
    .csm-flickity-slider .carousel-cell{
      padding-left: 5rem;
      padding-right: 5rem;
    }
  }

  @media (max-width: 465px){
    .csm-slide__content{
      max-width: 100% !important;
      align-items: {{section.settings.section_mobile_alignment}};
      text-align: {{section.settings.section_mobile_alignment}};
    }
  }
</style>

<div class="csm-flickity-slider color-{{ section.settings.color_scheme }}">
  {% for block in section.blocks %}
    <div class="carousel-cell" id="carousel-cell-{{ block.id }}"
    style="
      background-image:
      {% if block.settings.overlay_gradient != blank %}
        {{ block.settings.overlay_gradient }},
      {% endif %}
        url('{{ block.settings.image | image_url: width: 2000 }}');
    "
    >
      <div class="csm-slide__content">
        {% if block.settings.heading != blank %}
          <h2 class="{{ block.settings.heading_size }}">{{ block.settings.heading }}</h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <p>{{ block.settings.text }}</p>
        {% endif %}

        {% if block.settings.button_label != blank %}
          <a href="{{ block.settings.button_link }}" class="csm-slide__button">
            {{ block.settings.button_label }}
          </a>
        {% endif %}
      </div>
      <style>
        #carousel-cell-{{ block.id }}{
          padding-top: {{block.settings.desktop_padding_top }}px;
          padding-bottom: {{block.settings.desktop_padding_bottom }}px;
        }

        #carousel-cell-{{ block.id }} h2{
          letter-spacing: {{block.settings.heading_letter_spacing }}px;
          {% if block.settings.heading_uppercase %}text-transform: uppercase;{% endif %}
          margin-top: {{block.settings.heading_top_spacing }}px;
          margin-bottom: {{block.settings.heading_bottom_spacing }}px;
          margin-left: -4px;
        }

        #carousel-cell-{{ block.id }} p{
          margin-top: {{block.settings.text_top_spacing }}px;
          margin-bottom: {{block.settings.text_bottom_spacing }}px;
          font-size: 2.2rem;
          line-height: 30px;
        }

        #carousel-cell-{{ block.id }} .csm-slide__content{
          max-width: {{ block.settings.max_width }}px;
          width: 100%;
        }

        @media screen and (max-width: 768px) {
          #carousel-cell-{{ block.id }} {
            padding-top: {{ block.settings.mobile_padding_top }}px;
            padding-bottom: {{ block.settings.mobile_padding_bottom }}px;
          }
        }
      </style>
    </div>
  {% endfor %}
</div>

<script
  src="{{ 'flickity.pkgd.min.js' | asset_url }}"
  defer
></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  new Flickity('.csm-flickity-slider', {
    wrapAround: true,
    autoPlay: 3000,
    pauseAutoPlayOnHover: true,
    prevNextButtons: false,
    pageDots: true,
    draggable: true
  });
});
</script>

{% schema %}
{
  "name": "CSM Slideshow",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "section_desktop_alignment",
      "label": "Desktop Alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "select",
      "id": "section_mobile_alignment",
      "label": "Mobile Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "range",
          "id": "max_width",
          "label": "Max Width",
          "min": 100,
          "max": 1000,
          "step": 10,
          "default": 700,
          "unit": "px"
        },
        {
          "type": "color_background",
          "id": "overlay_gradient",
          "label": "Overlay gradient",
          "default": "linear-gradient(180deg, rgba(0,0,0,0.5), rgba(0,0,0,0.2))"
        },
        {
        "type": "image_picker",
        "id": "image",
        "label": "Background image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "header",
          "content": "Heading",
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__3.label"
            },
            {
              "value": "hxl",
              "label": "t:sections.all.heading_size.options__4.label"
            },
            {
              "value": "hxxl",
              "label": "t:sections.all.heading_size.options__5.label"
            }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        },
        {
          "type": "range",
          "id": "heading_letter_spacing",
          "label": "Heading Letter Spacing",
          "min": 0,
          "max": 10,
          "step": 1,
          "default": 0,
          "unit": "px"
        },
        {
          "type": "checkbox",
          "id": "heading_uppercase",
          "label": "Heading Uppercase Heading",
          "default": false
        },
        {
          "type": "range",
          "id": "heading_top_spacing",
          "label": "Heading Top Spacing",
          "min": 0,
          "max": 100,
          "step": 2,
          "default": 0,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "heading_bottom_spacing",
          "label": "Heading Bottom Spacing",
          "min": 0,
          "max": 100,
          "step": 2,
          "default": 0,
          "unit": "px"
        },
        {
          "type": "header",
          "content": "Text",
        },
        {
          "type": "range",
          "id": "text_top_spacing",
          "label": "Text Top Spacing",
          "min": 0,
          "max": 100,
          "step": 2,
          "default": 0,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "text_bottom_spacing",
          "label": "Text Bottom Spacing",
          "min": 0,
          "max": 100,
          "step": 2,
          "default": 0,
          "unit": "px"
        },
        {
          "type": "header",
          "content": "Padding",
        },
        {
          "type": "range",
          "id": "desktop_padding_top",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "Desktop Padding Top",
          "default": 80
        },
        {
          "type": "range",
          "id": "desktop_padding_bottom",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "Desktop Padding Bottom",
          "default": 80
        },
        {
          "type": "range",
          "id": "mobile_padding_top",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "Mobile Padding Top",
          "default": 60
        },
        {
          "type": "range",
          "id": "mobile_padding_bottom",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "Mobile Padding Bottom",
          "default": 60
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "CSM Slideshow"
    }
  ]
}
{% endschema %}